<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
	  <!--
    Единый источник правды для версии и метаданных сборки.
    MSBuild автоматически импортирует этот файл в каждый проект,
    поднимаясь вверх по дереву папок. Один файл в корне репо —
    покрывает всё (src/* и tests/*).

    VersionPrefix → MSBuild генерирует:
      AssemblyVersion      = 0.1.0.0
      FileVersion          = 0.1.0.0
      InformationalVersion = 0.1.0

    Firelink.Cli/Program.cs читает InformationalVersion из entry assembly.
    tools/build-release.bat читает VersionPrefix для имени артефакта.
  -->
    <VersionPrefix>0.1.0</VersionPrefix>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Firelink</Authors>
    <Product>Firelink</Product>
    <Copyright>Copyright (C) 2026 Firelink</Copyright>
  </PropertyGroup>
</Project>